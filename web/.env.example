# Copy this file to `web/.env.local` and paste the real key in.
# `.env.local` is git-ignored by create-next-app. The key must NEVER reach the browser
# or a commit — the server mints a short-lived token and only that token goes to the client.
#
# Key lives at: https://www.assemblyai.com/dashboard/api-keys
# One key covers Voice Agent API, Realtime STT, Dictation and the LLM Gateway.

ASSEMBLYAI_API_KEY=paste-your-key-here
